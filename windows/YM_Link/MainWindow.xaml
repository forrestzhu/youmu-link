<Window x:Class="YM_Link.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YM_Link" Width="1120" Height="760" MinWidth="860" MinHeight="580" SizeChanged="WindowSizeChanged" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid Background="{DynamicResource WindowSurface}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
      <Grid Margin="18,22,18,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,26">
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="/YM_Link;component/Resources/ym-link.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock Text="YM_Link" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeviceName" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource devices}" Foreground="{DynamicResource SecondaryInk}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="PeerCount" TextAlignment="Right" Style="{StaticResource Secondary}"/></DockPanel>
            <StackPanel x:Name="DiscoveryHint" Margin="8,6,8,20">
              <TextBlock Text="{DynamicResource searching_devices}" FontSize="13" Margin="0,0,0,8"/>
              <TextBlock Text="{DynamicResource same_network_hint}" Style="{StaticResource Secondary}"/>
            </StackPanel>
            <ListBox x:Name="PeerList" SelectionChanged="PeerSelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource devices}">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="12"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource forget_device}" IsEnabled="{Binding Data.Trusted}"><MenuItem.Style><Style TargetType="MenuItem"><EventSetter Event="Click" Handler="ForgetPeer"/></Style></MenuItem.Style></MenuItem></ContextMenu></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <Path DockPanel.Dock="Left" Width="21" Height="17" Stretch="Uniform" Margin="0,2,9,0" VerticalAlignment="Top" Data="M 3,3 Q 12,-1 21,3 L 23,12 Q 23,17 18,17 L 14,13 L 10,13 L 6,17 Q 1,17 1,12 Z" Stroke="{DynamicResource SecondaryInk}" StrokeThickness="1.4"/>
                    <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Tag="{Binding Id}" Click="PeerAction" FontSize="12" MinHeight="28" Padding="9,3" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Grid x:Name="PairedIndicator" Width="16" Height="16" Margin="0,0,5,0" IsHitTestVisible="False">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowsPairedStatus}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Ellipse x:Name="PairedRipple" Width="8" Height="8" Stroke="{DynamicResource SuccessInk}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5" IsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Minimized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <MultiTrigger>
                                  <MultiTrigger.Conditions><Condition Property="IsVisible" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                                  <MultiTrigger.EnterActions>
                                    <BeginStoryboard Name="PairedPulse" HandoffBehavior="SnapshotAndReplace">
                                      <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="2" Duration="0:0:2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="2" Duration="0:0:2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:2"/>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </MultiTrigger.EnterActions>
                                  <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="PairedPulse"/></MultiTrigger.ExitActions>
                                </MultiTrigger>
                                <EventTrigger RoutedEvent="Unloaded"><RemoveStoryboard BeginStoryboardName="PairedPulse"/></EventTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessInk}"/>
                      </Grid>
                      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>

            </ListBox>
            <DockPanel Margin="0,4,0,8">
              <Button x:Name="RescanButton" Content="{DynamicResource rescan}" Click="Rescan" Style="{StaticResource QuietButton}" FontSize="12" Margin="0"/>
            </DockPanel>
            <Expander Header="{DynamicResource connect_address}" Margin="0,0,0,20">
              <StackPanel Margin="0,10,2,0">
                <TextBlock Text="{DynamicResource address_hint}" Style="{StaticResource Secondary}" />
                <TextBlock Text="{DynamicResource firewall_hint}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                <TextBox x:Name="AddressDraft" MaxLength="64" Margin="0,10,0,5" KeyDown="AddressKeyDown" AutomationProperties.Name="{DynamicResource device_address}" />
                <TextBlock Text="{DynamicResource manual_address_example}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                <Button x:Name="AddressConnectButton" Content="{DynamicResource connect}" Click="ConnectAddress" HorizontalAlignment="Left" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource language}" Style="{StaticResource Secondary}" Margin="0,0,0,5" />
          <ComboBox x:Name="LanguageChoice" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource language}">
            <ComboBoxItem Tag="system" Content="{DynamicResource system_language}" /><ComboBoxItem Tag="en" Content="{DynamicResource language_english}" /><ComboBoxItem Tag="zh-Hans" Content="{DynamicResource language_chinese}" />
          </ComboBox>
          <TextBlock Text="{DynamicResource local_private}" Style="{StaticResource Secondary}" Margin="0,14,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="28,22">
        <Grid x:Name="WorkspaceHeader">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="PageHeading" Margin="0,0,20,0"><TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource Secondary}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
          <Border x:Name="WorkspaceTabs" Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource SelectedSurface}" CornerRadius="8" Padding="3" AutomationProperties.Name="{DynamicResource workspace}">
            <StackPanel x:Name="WorkspaceNavigation" Orientation="Horizontal">
              <RadioButton Content="{DynamicResource mirror}" Tag="mirror" GroupName="Workspace" Style="{StaticResource NavigationChoice}" Checked="WorkspaceChanged" IsChecked="True"/>
              <RadioButton Content="{DynamicResource shares}" Tag="shares" GroupName="Workspace" Style="{StaticResource NavigationChoice}" Checked="WorkspaceChanged"/>
              <RadioButton Content="{DynamicResource transfers}" Tag="transfers" GroupName="Workspace" Style="{StaticResource NavigationChoice}" Checked="WorkspaceChanged"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28">
        <StackPanel>
          <Border x:Name="ErrorPanel" Visibility="Collapsed" Padding="14" Background="{DynamicResource ErrorSurface}" CornerRadius="10" Margin="0,0,0,22">
            <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource dismiss}" Click="DismissError" Style="{StaticResource QuietButton}" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorInk}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/></DockPanel>
          </Border>
          <Border x:Name="PairingPanel" Visibility="Collapsed" Padding="18" Background="{DynamicResource SoftSurface}" CornerRadius="10" Margin="0,0,0,24">
            <StackPanel>
              <TextBlock Text="{DynamicResource pair_device}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock x:Name="PairingPeer" Margin="0,6,0,0" />
              <TextBlock x:Name="PairingHint" Style="{StaticResource Secondary}" Margin="0,8,0,12" />
              <Grid x:Name="PairingCodeArea" Width="280" Height="66" HorizontalAlignment="Left">
                <Grid.RenderTransform><TranslateTransform x:Name="PairingShake" /></Grid.RenderTransform>
                <TextBox x:Name="PairingDraft" FontFamily="Consolas" FontSize="32" MaxLength="4" Foreground="Transparent" CaretBrush="Transparent" Background="Transparent" BorderThickness="0" TextAlignment="Center" TextChanged="PairingTextChanged" KeyDown="PairingKeyDown" AutomationProperties.Name="{DynamicResource pairing_code}" />
                <StackPanel x:Name="PairingSlots" Orientation="Horizontal" IsHitTestVisible="False">
                  <Border Width="52" Height="66" CornerRadius="10" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Margin="0,0,24,0"><TextBlock x:Name="Code0" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <Border Width="52" Height="66" CornerRadius="10" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Margin="0,0,24,0"><TextBlock x:Name="Code1" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <Border Width="52" Height="66" CornerRadius="10" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Margin="0,0,24,0"><TextBlock x:Name="Code2" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <Border Width="52" Height="66" CornerRadius="10" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"><TextBlock x:Name="Code3" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="PairingError" Height="22" Foreground="{DynamicResource ErrorInk}" FontSize="12" AutomationProperties.LiveSetting="Assertive" />
              <TextBlock x:Name="PairingExpiry" Style="{StaticResource Secondary}" Margin="0,10,0,12" />
              <WrapPanel><Button Content="{DynamicResource cancel}" Click="CancelPairing" /><Button x:Name="PairRetryButton" Content="{DynamicResource pairing_retry}" Click="RetryPairing" Style="{StaticResource PrimaryButton}" /><TextBlock x:Name="WaitingPair" Text="{DynamicResource waiting_confirmation}" Style="{StaticResource Secondary}" VerticalAlignment="Center" /></WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="ConnectionNotice" Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="15" Margin="0,0,0,22">
            <StackPanel><TextBlock x:Name="ConnectionTitle" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource connection_hint}" Style="{StaticResource Secondary}" Margin="0,5,0,0" /></StackPanel>
          </Border>
          <Grid x:Name="WorkspaceContent">
<StackPanel x:Name="MirrorPage" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,18"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="{DynamicResource refresh}" Style="{StaticResource QuietButton}" Click="RefreshDisplays" Margin="12,0,0,0" /><TextBlock Text="{DynamicResource choose_display}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                <ListBox x:Name="DisplayChoice" SelectionChanged="DisplaySelectionChanged" SizeChanged="DisplayAreaSizeChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource choose_display}">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.Resources>
                    <!-- Native focus visuals appear for keyboard navigation; keep the cue inside the card. -->
                    <Style x:Key="DisplayCardFocus" TargetType="Control">
                      <Setter Property="Template">
                        <Setter.Value><ControlTemplate><Border Background="{DynamicResource Accent}" Width="32" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13,0,0,7" /></ControlTemplate></Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.Resources>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="2"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="FocusVisualStyle" Value="{StaticResource DisplayCardFocus}"/><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border CornerRadius="8,8,0,0">
                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource WindowSurface}"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                      <Grid>
                        <Path Width="58" Height="46" Stretch="Uniform" Data="M 3,3 L 69,3 L 69,45 L 3,45 Z M 36,45 L 36,57 M 23,57 L 49,57" StrokeThickness="1.5" StrokeLineJoin="Round">
                          <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{DynamicResource SecondaryInk}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Stroke" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16" Margin="10" Data="M 1,8 L 6,13 L 15,2" Stroke="{DynamicResource Accent}" StrokeThickness="2" Stretch="Uniform">
                          <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="11">
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,3"/><TextBlock Text="{Binding Resolution}" Style="{StaticResource Secondary}"/></StackPanel>
                    </Border>
                  </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="NoDisplays" Margin="0,30,0,38"><TextBlock x:Name="DisplaySummary" TextAlignment="Center" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="DisplayHint" TextAlignment="Center" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,22,0,0">
                  <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,24,16"><TextBlock Text="{DynamicResource system_audio}" FontWeight="SemiBold" Margin="0,0,0,10" /><CheckBox x:Name="AudioChoice" IsChecked="True" Content="{DynamicResource share_audio}" MinHeight="32" VerticalContentAlignment="Center" /></StackPanel>
                    <StackPanel Width="200" Margin="0,0,0,16"><TextBlock Text="{DynamicResource quality}" FontWeight="SemiBold" Margin="0,0,0,8" /><ComboBox x:Name="QualityChoice" SelectedIndex="1" AutomationProperties.Name="{DynamicResource quality}"><ComboBoxItem Tag="smooth" Content="{DynamicResource quality_smooth}" /><ComboBoxItem Tag="balanced" Content="{DynamicResource quality_balanced}" /><ComboBoxItem Tag="quality" Content="{DynamicResource quality_quality}" /></ComboBox></StackPanel>
                  </WrapPanel>
                </Border>
                <WrapPanel Margin="0,8,0,12"><Button x:Name="StartButton" Content="{DynamicResource start_mirror}" Click="StartMirror" Style="{StaticResource PrimaryButton}" /><Button x:Name="PauseButton" Content="{DynamicResource pause_mirror}" Click="PauseMirror" /><Button x:Name="ResumeButton" Content="{DynamicResource resume_mirror}" Click="ResumeMirror" Style="{StaticResource PrimaryButton}" /><Button x:Name="StopButton" Content="{DynamicResource stop_mirror}" Click="StopMirror" /></WrapPanel>
                <TextBlock x:Name="MirrorHint" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="MirrorError" Foreground="{DynamicResource ErrorInk}" Margin="0,10,0,0" />
                <TextBlock Text="{DynamicResource screen_permission}" Style="{StaticResource Secondary}" Margin="0,18,0,0" />
              </StackPanel>
<StackPanel x:Name="SharesPage" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,14"><Button x:Name="AddShareButton" DockPanel.Dock="Right" Content="{DynamicResource add_share}" Click="AddShare" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" /><TextBlock Text="{DynamicResource authorized_folders}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                <TextBlock Text="{DynamicResource share_boundary}" Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                <StackPanel x:Name="NoShares" Margin="0,52,0,52" HorizontalAlignment="Center">
                  <Path Data="M 2,8 L 2,31 L 42,31 L 42,5 L 21,5 L 17,1 L 2,1 Z M 17,19 L 29,19 M 23,13 L 23,25" Stroke="{DynamicResource SecondaryInk}" StrokeThickness="1.5" Width="44" Height="36" Stretch="Uniform" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource no_shares}" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource no_shares_hint}" TextAlignment="Center" Style="{StaticResource Secondary}" Margin="0,8,0,0" /></StackPanel>
                <ListBox x:Name="ShareList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource authorized_folders}">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><DockPanel><Path DockPanel.Dock="Left" Data="M 1,7 L 1,25 L 33,25 L 33,4 L 17,4 L 13,1 L 1,1 Z" Fill="{DynamicResource Accent}" Width="27" Height="24" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{DynamicResource remove}" Style="{StaticResource QuietButton}" Tag="{Binding Id}" Click="RemoveShare" Margin="12,0,0,0" VerticalAlignment="Center" /><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource SecondaryInk}" FontSize="12" Padding="0,4,0,0" MinHeight="0" TextWrapping="Wrap" AutomationProperties.Name="{Binding Name}" /></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
<StackPanel x:Name="TransfersPage" Visibility="Collapsed">
                <StackPanel x:Name="NoTransfers" Margin="0,72,0,72" HorizontalAlignment="Center">
                  <Path Data="M 22,1 A 21,21 0 1 1 21.99,1 M 22,11 L 22,32 M 13,23 L 22,32 L 31,23" Stroke="{DynamicResource SecondaryInk}" StrokeThickness="1.5" Width="44" Height="44" Stretch="Uniform" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource no_transfers}" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource no_transfers_hint}" TextAlignment="Center" Style="{StaticResource Secondary}" Margin="0,8,0,0" /></StackPanel>
                <ItemsControl x:Name="TransferList">
                  <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12"><StackPanel>
                    <DockPanel><TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="12" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></DockPanel>
                    <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,12,0,10" AutomationProperties.Name="{Binding Name}" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,10,0,0"><Button Content="{DynamicResource pause}" Tag="{Binding Id}" Click="PauseTransfer" IsEnabled="{Binding CanPause}" /><Button Content="{DynamicResource resume}" Tag="{Binding Id}" Click="ResumeTransfer" IsEnabled="{Binding CanResume}" /><Button Content="{DynamicResource cancel}" Tag="{Binding Id}" Click="CancelTransfer" IsEnabled="{Binding CanCancel}" /></WrapPanel>
                  </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Grid>


        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="22,12"><DockPanel><TextBlock Text="{DynamicResource local_network}" DockPanel.Dock="Right" Style="{StaticResource Secondary}" /><StackPanel><TextBlock x:Name="FooterStatus" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="FooterPorts" Style="{StaticResource Secondary}" FontSize="11" Margin="0,3,12,0" /></StackPanel></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
