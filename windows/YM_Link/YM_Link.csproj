<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns PerMonitorV2 through app.manifest; WinForms only hosts the tray menu. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YM_Link</AssemblyName>
    <RootNamespace>YM_Link</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/app-icon/YM_Link.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Resources/*.json" />
    <EmbeddedResource Include="../../assets/app-icon/YM_Link.ico" LogicalName="YM_Link.TrayIcon.ico" />
    <Resource Include="../../assets/app-icon/ym-link-1024.png" Link="Resources/ym-link.png" />
  </ItemGroup>
</Project>
