<Application x:Class="YM_Link.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarSurface" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SoftSurface" Color="#F5F7FA" />
    <SolidColorBrush x:Key="TextInk" Color="#17212C" />
    <SolidColorBrush x:Key="SecondaryInk" Color="#536171" />
    <SolidColorBrush x:Key="Hairline" Color="#D8DEE5" />
    <SolidColorBrush x:Key="Accent" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErrorSurface" Color="#FFF4EB" />
    <SolidColorBrush x:Key="ErrorInk" Color="#803C12" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource WindowSurface}" /><Setter Property="Foreground" Value="{DynamicResource TextInk}" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryInk}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="32" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="32" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="14,9" /></Style>
  </Application.Resources>
</Application>
